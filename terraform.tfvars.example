# このファイルを terraform.tfvars にコピーして値を設定してください。
# 必須なのは Slack の 2 項目だけで、それ以外は省略するとデフォルト値になります。

# ---- Slack（必須）----
slack_team_id    = "xxxxxxxxx"
slack_channel_id = "xxxxxxxxx"

# ---- アクセス過多の閾値 ----
request_count_threshold   = 1000 # この件数を超えたら通知
alarm_period_seconds      = 60   # 集計期間（秒）
alarm_evaluation_periods  = 1
alarm_datapoints_to_alarm = 1
notify_on_recovery        = true # 正常に戻ったときも通知

# ---- 共通 ----
# project_name = "alb-alert"
# aws_region   = "ap-northeast-1"
# tags         = { Owner = "yarimit" }

# ---- ネットワーク ----
# vpc_cidr = "10.20.0.0/16"
# public_subnets = {
#   "ap-northeast-1a" = "10.20.0.0/24"
#   "ap-northeast-1c" = "10.20.1.0/24"
# }
# alb_ingress_cidrs = ["0.0.0.0/0"]

# ---- Lambda ----
# lambda_runtime            = "python3.13"
